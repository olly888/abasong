# Local development only. Generate unique local credentials; never use production URLs.
LOCAL_POSTGRES_PASSWORD=generate-a-local-password
DATABASE_ADMIN_URL=postgresql://postgres:generate-a-local-password@127.0.0.1:54329/abasong_local
DATABASE_URL=postgresql://abasong_api_local:generate-a-runtime-password@127.0.0.1:54329/abasong_local
API_HOST=127.0.0.1
API_PORT=3001
WORKER_POLL_MS=5000

# env:init + db:verify create the isolated abasong_d0 database and worker login.
# WORKER_DATABASE_URL is generated locally by db:verify.

# Auth issuer must match the exact environment. No JWT secret/service-role key required.
AUTH_ISSUER=https://your-project.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWT_ALGORITHM=ES256
# env:init generates a local-only HMAC key; production retention must be approved separately.
IDEMPOTENCY_HMAC_KEY=
# Retention is a duration, not a credential.
IDEMPOTENCY_RETENTION_SECONDS=86400

# data:init-local generates these only for the isolated D0 environment, preserving existing keys.
# Never paste production credentials here. Dedicated role is NOT the ordinary API role.
# DATABASE_SENSITIVE_URL=generated-by-data-init-local
# DATA_ENCRYPTION_PROVIDER=local-development
# LOCAL_DATA_KEK=generated-32-byte-local-development-key

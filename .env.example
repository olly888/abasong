# Local development only. Generate unique local credentials; never use production URLs.
LOCAL_POSTGRES_PASSWORD=generate-a-local-password
DATABASE_ADMIN_URL=postgresql://postgres:generate-a-local-password@127.0.0.1:54329/abasong_local
DATABASE_URL=postgresql://abasong_api_local:generate-a-runtime-password@127.0.0.1:54329/abasong_local
API_HOST=127.0.0.1
API_PORT=3001
WORKER_POLL_MS=5000

# env:init + db:verify create the isolated abasong_d0 database and worker login.
# WORKER_DATABASE_URL is generated locally by db:verify.

# Public configuration only. Never put server/service-role/secret keys here.
# Leave empty for simulator defaults: iOS127.0.0.1:3001 / Android10.0.2.2:3001.
# Release and physical devices need an explicitly reachable HTTPS API.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Add approved, published HTTPS documents before external pilot.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

{
  "expo": {
    "name": "Abasong",
    "slug": "abasong",
    "version": "0.1.0",
    "scheme": "abasong",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abasong.mobile",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "将 Abasong 邀请图保存到你的照片。"
      }
    },
    "android": {
      "package": "com.abasong.mobile",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "使用当前位置查找附近公寓和临时支援。",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择需要整理的公寓截图，或要随司机圈动态发布的照片。",
          "cameraPermission": "拍摄配送现场照片，或在手机上识别面单地址以查找公寓。",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "选择需要整理的公寓截图，或要随司机圈动态发布的照片。",
          "savePhotosPermission": "将 Abasong 邀请图保存到你的照片。",
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1467D8",
          "defaultChannel": "collaboration",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

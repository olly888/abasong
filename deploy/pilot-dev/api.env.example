# Review-only template. Actual values belong in environment-specific Secrets Manager.
ABASONG_ENV=pilot-dev
NODE_ENV=production
AWS_REGION=us-west-1
PUBLIC_API_ORIGIN=https://api-dev.abasong.com
API_HOST=0.0.0.0
API_PORT=3001
AUTH_ISSUER=https://mxlmemaunzoramgemiju.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWT_ALGORITHM=ES256
DATA_ENCRYPTION_PROVIDER=aws-kms
DATA_HMAC_KEY_VERSION=pilot-v1
IDEMPOTENCY_RETENTION_SECONDS=86400
MAPBOX_PERMANENT_GEOCODING_ENABLED=false
# Set from the actual DevWest connection panel; session pooler5432 or direct TLS.
PILOT_DATABASE_HOST=REQUIRED_REVIEWED_HOST
DATABASE_URL=REQUIRED_API_LOGIN_TLS_URL
DATABASE_SENSITIVE_URL=REQUIRED_SENSITIVE_LOGIN_TLS_URL
KMS_KEY_ARN=REQUIRED_US_WEST_1_SYMMETRIC_KEY_ARN
DATA_HMAC_KEY=REQUIRED_NEW_32_BYTE_HEX_SECRET
MAPBOX_SEARCH_TOKEN=REQUIRED_SCOPED_PUBLIC_TOKEN

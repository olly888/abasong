#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export JAVA_HOME="${ABASONG_JAVA_HOME:-/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home}"
export ANDROID_HOME="${ABASONG_ANDROID_HOME:-$repo_root/.tooling/android-sdk}"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export ANDROID_USER_HOME="$repo_root/.tooling/android-user"
export ANDROID_AVD_HOME="$ANDROID_USER_HOME/avd"
mkdir -p "$ANDROID_AVD_HOME"
export GRADLE_USER_HOME="$repo_root/.tooling/gradle"
export PATH="$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"
if [ ! -x "$JAVA_HOME/bin/java" ]; then echo 'JDK required; set ABASONG_JAVA_HOME' >&2; exit 1; fi
command=${1:-}
[ "$#" -eq 0 ] || shift
case "$command" in
  run) exec "$repo_root/scripts/dev" --filter @abasong/mobile exec expo run:android "$@" ;;
  gradle) exec "$repo_root/scripts/dev" --filter @abasong/mobile exec sh -c 'cd android && exec ./gradlew "$@"' abasong-gradle "$@" ;;
  sdk) exec "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --sdk_root="$ANDROID_HOME" "$@" ;;
  avd) exec "$ANDROID_HOME/cmdline-tools/latest/bin/avdmanager" "$@" ;;
  emulator) exec "$ANDROID_HOME/emulator/emulator" "$@" ;;
  adb) exec "$ANDROID_HOME/platform-tools/adb" "$@" ;;
  *) echo 'Usage: ./scripts/android run|gradle|sdk|adb|avd|emulator [arguments]' >&2; exit 1 ;;
esac
